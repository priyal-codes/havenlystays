<script>
document.addEventListener("DOMContentLoaded", () => {
    const heroInput = document.getElementById("heroSearchInput");
    const heroDropdown = document.getElementById("heroSearchDropdown");

    if (heroInput && heroDropdown) {
        let debounceTimer;

        heroInput.addEventListener("input", (e) => {
            clearTimeout(debounceTimer);
            const query = e.target.value.trim();

            if (query.length < 1) {
                heroDropdown.classList.add("d-none");
                heroDropdown.innerHTML = "";
                return;
            }

            debounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/listings/api/search?q=${encodeURIComponent(query)}`);
                    const data = await res.json();

                    if (data && data.length > 0) {
                        let html = "";
                        data.forEach(item => {
                            const imgUrl = item.image && item.image.url ? item.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=100';
                            html += `
                                <a href="/listings/${item._id}" class="suggestion-item">
                                    <img src="${imgUrl}" class="suggestion-img" alt="${item.title}"/>
                                    <div>
                                        <p class="suggestion-title">${item.title}</p>
                                        <p class="suggestion-sub"><i class="fa-solid fa-location-dot me-1 text-danger"></i>${item.location || ''}, ${item.country || ''}</p>
                                    </div>
                                    <div class="ms-auto text-end">
                                        <span class="badge bg-danger">₹${item.price ? item.price.toLocaleString("en-IN") : 'N/A'}</span>
                                    </div>
                                </a>
                            `;
                        });
                        heroDropdown.innerHTML = html;
                        heroDropdown.classList.remove("d-none");
                    } else {
                        heroDropdown.innerHTML = `<div class="p-3 text-center text-secondary small"><i class="fa-solid fa-ghost me-1"></i> No matching stays found</div>`;
                        heroDropdown.classList.remove("d-none");
                    }
                } catch (err) {
                    console.error("Hero search suggestion error:", err);
                }
            }, 250);
        });

        document.addEventListener("click", (e) => {
            if (!heroInput.contains(e.target) && !heroDropdown.contains(e.target)) {
                heroDropdown.classList.add("d-none");
            }
        });
    }

    // Month Stepper Handler
    const monthInput = document.getElementById("monthInput");
    const monthUpBtn = document.getElementById("monthUpBtn");
    const monthDownBtn = document.getElementById("monthDownBtn");

    if (monthInput && monthUpBtn && monthDownBtn) {
        const months = [
            "January", "February", "March", "April", "May", "June", 
            "July", "August", "September", "October", "November", "December"
        ];
        let currentIndex = -1;

        function setMonthIndex(idx) {
            if (idx < 0) {
                currentIndex = months.length - 1;
            } else if (idx >= months.length) {
                currentIndex = 0;
            } else {
                currentIndex = idx;
            }
            monthInput.value = months[currentIndex];
        }

        monthUpBtn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (currentIndex === -1) {
                setMonthIndex(new Date().getMonth());
            } else {
                setMonthIndex(currentIndex + 1);
            }
        });

        monthDownBtn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (currentIndex === -1) {
                setMonthIndex(new Date().getMonth());
            } else {
                setMonthIndex(currentIndex - 1);
            }
        });

        monthInput.addEventListener("click", () => {
            if (currentIndex === -1) {
                setMonthIndex(new Date().getMonth());
            } else {
                setMonthIndex(currentIndex + 1);
            }
        });
    }
});

async function toggleWishlist(listingId, event, btnEl) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    try {
        const response = await fetch(`/wishlist/${listingId}/toggle`, {
            method: "POST",
            headers: {
                "Accept": "application/json",
                "X-Requested-With": "XMLHttpRequest"
            }
        });
        const data = await response.json();
        if (data.success) {
            const icon = btnEl.querySelector("i");
            if (data.saved) {
                icon.className = "fa-solid fa-heart text-danger";
                btnEl.title = "Remove from wishlist";
            } else {
                icon.className = "fa-regular fa-heart";
                btnEl.title = "Save to wishlist";
            }
        }
    } catch(err) {
        console.error("Error toggling wishlist:", err);
    }
}
</script>
