<% layout("layouts/boilerplate") -%>

<style>
/* Font Helpers */
.font-cursive {
    font-family: 'Caveat', cursive;
}

.font-serif-italic {
    font-family: 'Playfair Display', serif;
    font-style: italic;
}

/* Full Width Hero Section */
.full-hero {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    min-height: 540px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0.75) 100%),
                url('https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem 6rem 1.5rem;
    color: #ffffff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
}

.hero-content-wrapper {
    max-width: 960px;
    width: 100%;
    text-align: center;
    margin: 0 auto;
}

.hero-badge-pill {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.45rem 1.5rem;
    border-radius: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.hero-main-heading {
    font-size: 3.8rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #ffffff;
    margin-top: 1.25rem;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
}

.hero-cursive-accent {
    font-family: 'Caveat', cursive;
    font-weight: 700;
    font-size: 4.5rem;
    color: #fe424d;
    text-shadow: 0 2px 15px rgba(254, 66, 77, 0.5);
    display: inline-block;
}

.hero-sub-text {
    font-size: 1.3rem;
    color: #f1f5f9;
    margin-top: 1rem;
    font-weight: 300;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    text-shadow: 0 1px 5px rgba(0,0,0,0.4);
}

/* Floating Search Widget */
.hero-search-container {
    background: #ffffff;
    border-radius: 2rem;
    padding: 0.85rem 1.25rem;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
    margin-top: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    text-align: left;
}

.search-field-title {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.6px;
    margin-bottom: 0.15rem;
}

.search-field-input {
    border: none !important;
    background: transparent !important;
    font-weight: 700;
    color: #0f172a;
    padding-left: 0 !important;
    font-size: 0.98rem;
}

.search-field-input:focus {
    box-shadow: none !important;
}

.search-field-divider {
    border-right: 1px solid #e2e8f0;
}

/* Month Stepper Component */
.month-stepper-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
}

.month-stepper-arrows {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1px;
    z-index: 10;
}

.month-stepper-btn {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: #64748b;
    font-size: 0.7rem;
    line-height: 0.7;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.1s ease;
}

.month-stepper-btn:hover {
    color: #fe424d;
    transform: scale(1.25);
}

.month-stepper-btn:active {
    transform: scale(0.95);
}

.btn-brand-search {
    background: linear-gradient(135deg, #fe424d 0%, #e0313c 100%);
    color: #ffffff;
    font-weight: 700;
    border-radius: 1.5rem;
    padding: 0.95rem 2.25rem;
    border: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(254, 66, 77, 0.4);
    width: 100%;
}

.btn-brand-search:hover {
    background: linear-gradient(135deg, #e0313c 0%, #c82333 100%);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 12px 28px rgba(254, 66, 77, 0.55);
    color: #ffffff;
}

/* Trust Stats Pill Bar */
.trust-stats-bar {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
}

.trust-stat-pill {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 2rem;
    padding: 0.4rem 1.2rem;
    font-size: 0.9rem;
    color: #ffffff;
    font-weight: 600;
}

/* Categories Section */
.category-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: 1.35rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #475569;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}

.category-item:hover {
    background: #fe424d;
    color: #ffffff;
    border-color: #fe424d;
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(254, 66, 77, 0.3);
}

.category-item i {
    font-size: 1.4rem;
}

@media (max-width: 767px) {
    .full-hero {
        padding: 3rem 1rem;
        min-height: 520px;
    }
    .hero-badge-pill {
        font-size: 0.82rem;
        padding: 0.35rem 1rem;
        gap: 0.3rem;
        max-width: 100%;
        box-sizing: border-box;
    }
    .hero-main-heading {
        font-size: 1.85rem !important;
        line-height: 1.25;
        margin-top: 0.75rem;
    }
    .hero-cursive-accent {
        font-size: 2.15rem !important;
    }
    .hero-sub-text {
        font-size: 0.9rem !important;
        line-height: 1.45;
        margin-top: 0.6rem;
    }
    .hero-search-container {
        padding: 1rem;
        margin-top: 1.25rem;
        border-radius: 1.4rem;
    }
    .search-field-title {
        font-size: 0.68rem;
    }
    .search-field-input {
        font-size: 0.88rem !important;
    }
    .search-field-input::placeholder {
        font-size: 0.82rem;
    }
    .search-field-divider {
        border-right: none !important;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 0.45rem;
        margin-bottom: 0.45rem;
    }
    .btn-brand-search {
        width: 100%;
        margin-top: 0.4rem;
        padding: 0.65rem 1rem;
        font-size: 0.9rem;
    }
    .trust-stats-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem;
        margin-top: 1.5rem;
    }
    .trust-stat-pill {
        font-size: 0.76rem;
        padding: 0.35rem 0.8rem;
    }
    .categories-horizontal-scroll {
        display: flex;
        overflow-x: auto;
        flex-wrap: nowrap !important;
        justify-content: flex-start !important;
        padding-bottom: 0.75rem;
        -webkit-overflow-scrolling: touch;
    }
    .category-item {
        flex-shrink: 0;
        padding: 0.4rem 0.65rem;
        border-radius: 0.85rem;
        font-size: 0.72rem;
    }
    .category-item i {
        font-size: 0.95rem;
    }

    /* Mobile 2x2 Grid & Section Sizing */
    .section-headline {
        font-size: 1.4rem !important;
    }
    .cursive-tagline {
        font-size: 1.25rem !important;
    }
    .stay-card-img-wrapper {
        height: 105px !important;
    }
    .stay-badge-location {
        font-size: 0.58rem !important;
        padding: 0.15rem 0.45rem !important;
        top: 0.35rem !important;
        left: 0.35rem !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        max-width: 82% !important;
    }
    .stay-card .card-body {
        padding: 0.6rem !important;
    }
    .stay-card h5 {
        font-size: 0.8rem !important;
        max-width: 68% !important;
    }
    .stay-card .badge {
        font-size: 0.62rem !important;
        padding: 0.15rem 0.35rem !important;
    }
    .stay-card p.text-secondary {
        display: none !important;
    }
    .stay-card-price {
        font-size: 0.74rem !important;
        white-space: nowrap !important;
        display: inline-flex !important;
        align-items: baseline !important;
        gap: 0.15rem !important;
    }
    .stay-card-price span {
        font-size: 0.58rem !important;
        white-space: nowrap !important;
    }
    .stay-card .btn-danger {
        font-size: 0.58rem !important;
        padding: 0.18rem 0.45rem !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
    }
    .testimonials-horizontal-scroll {
        display: flex !important;
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        justify-content: flex-start !important;
        gap: 1rem !important;
        padding-bottom: 0.75rem !important;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
    }
    .testimonials-horizontal-scroll > [class*="col-"] {
        flex: 0 0 85% !important;
        max-width: 85% !important;
        scroll-snap-align: start;
    }
    .testimonial-box {
        padding: 1.25rem !important;
        border-radius: 1.25rem !important;
        height: 100%;
    }
    .testimonial-quote {
        font-size: 0.88rem !important;
        line-height: 1.45 !important;
    }
    .host-cta-card {
        padding: 1.5rem 1.25rem !important;
        border-radius: 1.4rem !important;
        margin-top: 2rem !important;
        margin-bottom: 2rem !important;
        text-align: center;
        justify-content: center !important;
    }
    .host-cta-card h2 {
        font-size: 1.35rem !important;
    }
    .host-cta-card p {
        font-size: 0.88rem !important;
    }
    .host-cta-card .btn-danger {
        padding: 0.65rem 1.5rem !important;
        font-size: 0.88rem !important;
        white-space: nowrap !important;
        width: 100%;
    }
}

@media (max-width: 480px) {
    .hero-main-heading {
        font-size: 1.65rem !important;
    }
    .hero-cursive-accent {
        font-size: 1.95rem !important;
    }
    .hero-badge-pill {
        font-size: 0.75rem;
        padding: 0.3rem 0.75rem;
    }
    .hero-sub-text {
        font-size: 0.85rem !important;
    }
}

/* Section Typography */
.section-headline {
    font-size: 2.3rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
}

.cursive-tagline {
    font-family: 'Caveat', cursive;
    font-size: 1.7rem;
    color: #fe424d;
    font-weight: 700;
}

/* Stay Cards */
.stay-card {
    border: none;
    border-radius: 1.6rem;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: all 0.35s ease;
    height: 100%;
}

.stay-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px rgba(0, 0, 0, 0.13);
}

.stay-card-img-wrapper {
    position: relative;
    height: 240px;
    overflow: hidden;
}

.stay-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.stay-card:hover .stay-card-img {
    transform: scale(1.08);
}

.stay-badge-location {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff !important;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 2rem;
    z-index: 10;
    pointer-events: none;
    transition: all 0.3s ease;
}

.stay-card:hover .stay-badge-location {
    color: #ffffff !important;
    background: rgba(15, 23, 42, 0.92);
    z-index: 10;
}

.stay-card-price {
    font-weight: 800;
    font-size: 1.25rem;
    color: #0f172a;
}

/* Testimonial Cards */
.testimonial-box {
    background: #ffffff;
    border-radius: 1.6rem;
    padding: 2.25rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
}

.testimonial-quote {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.15rem;
    color: #334155;
    line-height: 1.65;
}

/* Host CTA */
.host-cta-card {
    background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 50%, #fecdd3 100%);
    border-radius: 2.25rem;
    padding: 4rem 3.5rem;
    margin-top: 4.5rem;
    margin-bottom: 3.5rem;
    border: 1px solid #fca5a5;
}
</style>

<!-- Full Width Hero Section (Edge to Edge) -->
<div class="full-hero">
    <div class="hero-content-wrapper">
        <div class="hero-badge-pill">
            <i class="fa-solid fa-compass text-danger me-1"></i>
            <span class="font-cursive fs-5 me-1 d-none d-sm-inline">where magic meets comfort • </span>Handpicked Haven Stays
        </div>
        <h1 class="hero-main-heading">
            Find Your Haven, <br class="d-none d-sm-inline">
            <span class="hero-cursive-accent">Feel Entirely at Home.</span>
        </h1>
        <p class="hero-sub-text font-serif-italic">
            "Discover handpicked luxury villas, beachfront sanctuaries, and cozy mountain chalets curated for your perfect getaway."
        </p>

        <!-- Centered Floating Search Bar with Live Suggestions Dropdown -->
        <div class="hero-search-container position-relative">
            <form action="/listings" method="GET" class="row g-2 align-items-center">
                <div class="col-md-4 search-field-divider ps-2 position-relative">
                    <div class="search-field-title"><i class="fa-solid fa-location-dot text-danger me-1"></i> Destination</div>
                    <input type="text" id="heroSearchInput" name="search" class="form-control search-field-input" autocomplete="off" placeholder="Where is your heart taking you?">
                    <div id="heroSearchDropdown" class="search-suggestions-dropdown d-none text-start"></div>
                </div>
                <div class="col-md-3 search-field-divider ps-2">
                    <div class="search-field-title"><i class="fa-regular fa-calendar-check text-primary me-1"></i> Month</div>
                    <div class="month-stepper-container">
                        <input type="text" id="monthInput" name="month" class="form-control search-field-input pe-4 cursor-pointer" readonly placeholder="Add month" autocomplete="off">
                        <div class="month-stepper-arrows">
                            <button type="button" id="monthUpBtn" class="month-stepper-btn" title="Next month">
                                <i class="fa-solid fa-caret-up"></i>
                            </button>
                            <button type="button" id="monthDownBtn" class="month-stepper-btn" title="Previous month">
                                <i class="fa-solid fa-caret-down"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 ps-2">
                    <div class="search-field-title"><i class="fa-solid fa-users text-warning me-1"></i> Guests</div>
                    <input type="number" min="1" max="20" name="guests" class="form-control search-field-input" placeholder="Add guests">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-brand-search">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                    </button>
                </div>
            </form>
        </div>

        <!-- Trust Stats -->
        <div class="trust-stats-bar">
            <div class="trust-stat-pill"><i class="fa-solid fa-circle-check text-success me-1"></i> 1,200+ Verified Havens</div>
            <div class="trust-stat-pill"><i class="fa-solid fa-star text-warning me-1"></i> 4.9★ Average Rating</div>
            <div class="trust-stat-pill"><i class="fa-solid fa-shield-heart text-danger me-1"></i> 100% Superhost Guarantee</div>
        </div>
    </div>
</div>

<!-- Rest of Content Inside Standard Container -->
<div class="container py-4">

    <!-- Categories Bar -->
    <div class="my-5">
        <div class="text-center mb-4">
            <span class="cursive-tagline">curated by experience</span>
            <h3 class="fw-bold text-dark mb-0">What style of stay are you craving?</h3>
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-3 categories-horizontal-scroll">
            <a href="/listings?category=Trending" class="category-item">
                <i class="fa-solid fa-fire text-danger"></i>
                <span>Trending Stays</span>
            </a>
            <a href="/listings?category=Beachfront" class="category-item">
                <i class="fa-solid fa-umbrella-beach text-info"></i>
                <span>Beachfront</span>
            </a>
            <a href="/listings?category=Mountains" class="category-item">
                <i class="fa-solid fa-mountain text-success"></i>
                <span>Cabins & Peaks</span>
            </a>
            <a href="/listings?category=Iconic+cities" class="category-item">
                <i class="fa-solid fa-mountain-city text-warning"></i>
                <span>Iconic Cities</span>
            </a>
            <a href="/listings?category=Pools" class="category-item">
                <i class="fa-solid fa-person-swimming text-primary"></i>
                <span>Private Pools</span>
            </a>
            <a href="/listings?category=Castles" class="category-item">
                <i class="fa-solid fa-fort-awesome text-secondary"></i>
                <span>Heritage Castles</span>
            </a>
            <a href="/listings?category=Arctic" class="category-item">
                <i class="fa-solid fa-snowflake text-info"></i>
                <span>Arctic Escapes</span>
            </a>
        </div>
    </div>

    <!-- Featured Haven Stays -->
    <div class="my-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 mb-md-4">
            <div>
                <span class="cursive-tagline">handpicked sanctuaries</span>
                <h2 class="section-headline mb-0">Featured Haven Stays</h2>
            </div>
            <a href="/listings" class="btn btn-outline-danger rounded-pill px-3 py-1 fw-bold small">
                Explore All <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-2 g-2 g-md-4">
            <% if(featuredListings && featuredListings.length > 0) { %>
                <% for(let listing of featuredListings) { %>
                    <div class="col">
                        <a href="/listings/<%= listing._id %>" class="text-decoration-none">
                            <div class="stay-card">
                                <div class="stay-card-img-wrapper">
                                    <% if (currUser) { %>
                                        <% let isSaved = currUser.wishlist && Array.isArray(currUser.wishlist) && currUser.wishlist.some(w => w && (w._id ? w._id.toString() === listing._id.toString() : w.toString() === listing._id.toString())); %>
                                        <button type="button" class="heart-btn-floating" onclick="toggleWishlist('<%= listing._id %>', event, this)" title="<%= isSaved ? 'Remove from wishlist' : 'Save to wishlist' %>">
                                            <i class="<%= isSaved ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                                        </button>
                                    <% } else { %>
                                        <a href="/login" class="heart-btn-floating" onclick="event.stopPropagation();" title="Log in to save to wishlist">
                                            <i class="fa-regular fa-heart"></i>
                                        </a>
                                    <% } %>
                                    <img src="<%= listing.image.url %>" class="stay-card-img" alt="<%= listing.title %>">
                                    <span class="stay-badge-location">
                                        <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %>
                                    </span>
                                </div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 75%;"><%= listing.title %></h5>
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="fa-solid fa-star me-1"></i>4.9</span>
                                    </div>
                                    <p class="text-secondary small text-truncate mb-3"><%= listing.description %></p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="stay-card-price">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <span class="text-secondary fw-normal fs-6">/ night</span></span>
                                        <span class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-bold">View Stay</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                <% } %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <p class="text-secondary fs-5 font-serif-italic">No listings found yet. Be the first host to create one!</p>
                    <a href="/listings/new" class="btn btn-danger rounded-pill px-4 py-2">Create Your First Listing</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Testimonials Section -->
    <div class="my-4 pt-2">
        <div class="text-center mb-4">
            <span class="cursive-tagline">real stories from real travelers</span>
            <h2 class="section-headline">Loved by Travelers Worldwide</h2>
        </div>
        <div class="row g-4 testimonials-horizontal-scroll">
            <div class="col-md-4">
                <div class="testimonial-box">
                    <div class="text-warning mb-3">
                        <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                    </div>
                    <p class="testimonial-quote">
                        "Havenly Stays gave us the most peaceful villa retreat in Bali. Waking up to private pool views was pure magic."
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-4">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px;">P</div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Priya Sharma</h6>
