<% layout("/layouts/boilerplate.ejs") %>
<style>
.profile-hero-card {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid #e2e8f0;
    border-radius: 2rem;
    padding: 2.5rem;
    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
    margin-bottom: 2.5rem;
    position: relative;
    overflow: hidden;
}

.profile-hero-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, #fe424d 0%, #ff7882 100%);
}

.profile-avatar-large {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fe424d 0%, #e11d48 100%);
    color: #ffffff;
    font-size: 2.8rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(254, 66, 77, 0.3);
    border: 4px solid #ffffff;
}

.stat-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    padding: 1.25rem 1.5rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
}

.stat-box:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-color: #fca5a5;
}

.stat-num {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1;
}

.nav-tabs-custom {
    border-bottom: 2px solid #e2e8f0;
    gap: 0.5rem;
}

.nav-tabs-custom .nav-link {
    border: none;
    color: #64748b;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: 40px;
    transition: all 0.25s ease;
    background: transparent;
}

.nav-tabs-custom .nav-link.active {
    color: #fe424d;
    background: #fff1f2;
}

.nav-tabs-custom .nav-link:hover:not(.active) {
    color: #0f172a;
    background: #f8fafc;
}

.profile-stay-card {
    border: none;
    border-radius: 1.4rem;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    height: 100%;
}

.profile-stay-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.1);
}

.profile-stay-img {
    height: 180px;
    width: 100%;
    object-fit: cover;
}
</style>

<div class="py-4">
    <!-- Hero Profile Section -->
    <div class="profile-hero-card">
        <div class="row align-items-center g-4">
            <div class="col-auto">
                <div class="profile-avatar-large">
                    <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                    <h2 class="fw-extrabold text-dark mb-0" style="font-weight: 800;"><%= user.username %></h2>
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-bold">
                        <i class="fa-solid fa-circle-check me-1"></i>Verified Member
                    </span>
                    <% if (userListings && userListings.length > 0) { %>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 fw-bold">
                            <i class="fa-solid fa-crown me-1"></i>Host
                        </span>
                    <% } %>
                </div>
                <p class="text-secondary small mb-3">
                    <i class="fa-regular fa-envelope me-1 text-danger"></i><%= user.email %>
                </p>
                <div class="d-flex align-items-center gap-3">
                    <a href="/listings/new" class="btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                        <i class="fa-solid fa-plus me-1"></i>Host New Stay
                    </a>
                    <a href="/logout" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-bold">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>Log out
                    </a>
                </div>
            </div>
            
            <!-- Quick Stat Counters -->
            <div class="col-lg-5">
                <div class="row g-3">
                    <div class="col-4">
                        <div class="stat-box text-center">
                            <div class="stat-num text-danger"><%= userListings ? userListings.length : 0 %></div>
                            <div class="text-secondary extra-small fw-semibold mt-1" style="font-size: 0.72rem;">Hosted Stays</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box text-center">
                            <div class="stat-num text-primary"><%= userBookings ? userBookings.length : 0 %></div>
                            <div class="text-secondary extra-small fw-semibold mt-1" style="font-size: 0.72rem;">Booked Trips</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box text-center">
                            <div class="stat-num text-warning"><%= (user.wishlist && Array.isArray(user.wishlist)) ? user.wishlist.length : 0 %></div>
                            <div class="text-secondary extra-small fw-semibold mt-1" style="font-size: 0.72rem;">Wishlist</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs nav-tabs-custom mb-4" id="profileTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="hosted-tab" data-bs-toggle="tab" data-bs-target="#hosted-pane" type="button" role="tab">
                <i class="fa-solid fa-house-user me-2 text-danger"></i>My Hosted Stays (<%= userListings ? userListings.length : 0 %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="trips-tab" data-bs-toggle="tab" data-bs-target="#trips-pane" type="button" role="tab">
                <i class="fa-solid fa-suitcase-rolling me-2 text-danger"></i>My Booked Trips (<%= userBookings ? userBookings.length : 0 %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <a href="/wishlist" class="nav-link text-decoration-none">
                <i class="fa-solid fa-heart me-2 text-danger"></i>My Wishlist (<%= (user.wishlist && Array.isArray(user.wishlist)) ? user.wishlist.length : 0 %>)
            </a>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="profileTabContent">
        <!-- Hosted Stays Tab -->
        <div class="tab-pane fade show active" id="hosted-pane" role="tabpanel">
            <% if (userListings && userListings.length > 0) { %>
                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
                    <% for (let listing of userListings) { %>
                        <div class="col">
                            <div class="profile-stay-card">
                                <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=600' %>" class="profile-stay-img" alt="<%= listing.title %>">
                                <div class="p-3">
                                    <h6 class="fw-bold text-dark text-truncate mb-1"><%= listing.title %></h6>
                                    <p class="text-secondary small mb-2">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> <span class="text-secondary small">/ night</span></span>
                                        <div class="d-flex gap-1">
                                            <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 fw-bold">
                                                <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="bg-white rounded-4 p-5 text-center border">
                    <i class="fa-solid fa-house-circle-exclamation text-danger display-4 mb-3"></i>
                    <h4 class="fw-bold text-dark mb-1">No Hosted Stays Yet</h4>
                    <p class="text-secondary small mb-4">Share your luxury space with travelers from around the world and start earning.</p>
                    <a href="/listings/new" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-plus me-1"></i>Create First Listing
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Booked Trips Tab -->
        <div class="tab-pane fade" id="trips-pane" role="tabpanel">
            <% if (userBookings && userBookings.length > 0) { %>
                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
                    <% for (let booking of userBookings) { %>
                        <% if (booking.listing) { %>
                            <div class="col">
                                <div class="profile-stay-card">
                                    <img src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=600' %>" class="profile-stay-img" alt="<%= booking.listing.title %>">
                                    <div class="p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="fw-bold text-dark text-truncate me-2 mb-0"><%= booking.listing.title %></h6>
                                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 extra-small fw-bold">Confirmed</span>
                                        </div>
                                        <p class="text-secondary extra-small mb-2" style="font-size: 0.78rem;">
                                            <i class="fa-regular fa-calendar-check text-danger me-1"></i>
                                            <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) %> - <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                            <span class="fw-extrabold text-dark">&#8377;<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : 0 %></span>
                                            <a href="/bookings" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                                Manage <i class="fa-solid fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            <% } else { %>
                <div class="bg-white rounded-4 p-5 text-center border">
                    <i class="fa-solid fa-suitcase-rolling text-danger display-4 mb-3"></i>
                    <h4 class="fw-bold text-dark mb-1">No Booked Trips Yet</h4>
                    <p class="text-secondary small mb-4">You haven't booked any stay yet. Explore our luxury collection and plan your next getaway!</p>
                    <a href="/listings" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-compass me-1"></i>Explore Stays
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>
