<% layout("layouts/boilerplate") -%>

<style>
.filter-container {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
    scrollbar-width: none; /* Firefox */
}

.filter-container::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
}

.filter-link {
    text-decoration: none;
    color: #64748b;
    text-align: center;
    opacity: 0.75;
    transition: all 0.2s ease;
    flex-shrink: 0;
    padding: 0.4rem 0.8rem;
    border-radius: 12px;
}

.filter-link:hover, .filter-link.active-filter {
    opacity: 1;
    color: #fe424d;
    background: #fff1f2;
}

.filter-link i {
    font-size: 1.35rem;
    margin-bottom: 0.3rem;
    display: block;
}

.filter-link p {
    font-size: 0.78rem;
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
}

.tax-toggle-box {
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    height: 3.2rem;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    flex-shrink: 0;
    margin-left: auto;
}

.search-status-bar {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Premium Stay Card Styling matching Home Page */
.listing-link {
    text-decoration: none !important;
}

.stay-card {
    border: none;
    border-radius: 1.6rem;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: all 0.35s ease;
    height: 100%;
}

.stay-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px rgba(0, 0, 0, 0.13);
}

.stay-card-img-wrapper {
    position: relative;
    height: 240px;
    overflow: hidden;
}

.stay-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.stay-card:hover .stay-card-img {
    transform: scale(1.08);
}

.stay-badge-location {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff !important;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 2rem;
    z-index: 10;
    pointer-events: none;
    transition: all 0.3s ease;
}

.stay-card:hover .stay-badge-location {
    color: #ffffff !important;
    background: rgba(15, 23, 42, 0.92);
    z-index: 10;
}

.stay-card-price {
    font-weight: 800;
    font-size: 1.25rem;
    color: #0f172a;
}

@media (max-width: 767px) {
    .tax-toggle-box {
        margin-left: 0;
        width: 100%;
        justify-content: center;
        height: 2.8rem;
    }
    .stay-card-img-wrapper {
        height: 105px !important;
    }
    .stay-badge-location {
        font-size: 0.58rem !important;
        padding: 0.15rem 0.45rem !important;
        top: 0.35rem !important;
        left: 0.35rem !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        max-width: 82% !important;
    }
    .stay-card .card-body {
        padding: 0.6rem !important;
    }
    .stay-card h5 {
        font-size: 0.8rem !important;
        max-width: 68% !important;
    }
    .stay-card .badge {
        font-size: 0.62rem !important;
        padding: 0.15rem 0.35rem !important;
    }
    .stay-card p.text-secondary {
        display: none !important;
    }
    .stay-card-price {
        font-size: 0.82rem !important;
        white-space: nowrap !important;
    }
    .stay-card-price span {
        font-size: 0.6rem !important;
        white-space: nowrap !important;
    }
    .stay-card .btn-danger {
        font-size: 0.62rem !important;
        padding: 0.2rem 0.5rem !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
    }
}
</style>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-2">
    <!-- Scrollable Filter Pills Bar -->
    <div class="filter-container flex-grow-1">
        <a href="/listings" class="filter-link <%= !category && !search ? 'active-filter' : '' %>">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </a>
        <a href="/listings?category=Rooms" class="filter-link <%= category === 'Rooms' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
        </a>
        <a href="/listings?category=Iconic+cities" class="filter-link <%= category === 'Iconic cities' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-mountain-city"></i>
            <p>Iconic cities</p>
        </a>
        <a href="/listings?category=Mountains" class="filter-link <%= category === 'Mountains' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
        </a>
        <a href="/listings?category=Castles" class="filter-link <%= category === 'Castles' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-fort-awesome"></i>
            <p>Castles</p>
        </a>
        <a href="/listings?category=Pools" class="filter-link <%= category === 'Pools' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-person-swimming"></i>
            <p>Amazing Pools</p>
        </a>
        <a href="/listings?category=Camping" class="filter-link <%= category === 'Camping' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-campground"></i>
            <p>Camping</p>
        </a>
        <a href="/listings?category=Farms" class="filter-link <%= category === 'Farms' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-cow"></i>
            <p>Farms</p>
        </a>
        <a href="/listings?category=Arctic" class="filter-link <%= category === 'Arctic' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-snowflake"></i>
            <p>Arctic</p>
        </a>
        <a href="/listings?category=Beachfront" class="filter-link <%= category === 'Beachfront' ? 'active-filter' : '' %>">
            <i class="fa-solid fa-umbrella-beach"></i>
            <p>Beachfront</p>
        </a>
    </div>

    <!-- Tax Toggle Switch -->
    <div class="tax-toggle-box">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input me-2" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="cursor: pointer;">
            <label class="form-check-label fw-semibold small text-secondary" for="flexSwitchCheckDefault" style="cursor: pointer;">Display total after taxes</label>
        </div>
    </div>
</div>

<!-- Active Search / Filter Status Banner -->
<% if (search || category || selectedMonth || guests) { %>
    <div class="search-status-bar mt-3">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="text-secondary fw-semibold">Filtering results by:</span>
            <% if (search) { %>
                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-location-dot me-1"></i> Destination: "<%= search %>"</span>
            <% } %>
            <% if (category) { %>
                <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-layer-group me-1"></i> "<%= category %>"</span>
            <% } %>
            <% if (selectedMonth) { %>
                <span class="badge bg-info text-dark fs-6 px-3 py-2 rounded-pill"><i class="fa-regular fa-calendar-check me-1"></i> Month: <%= selectedMonth %></span>
            <% } %>
            <% if (guests) { %>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill"><i class="fa-solid fa-users me-1"></i> <%= guests %> Guests</span>
            <% } %>
            <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill ms-auto"><%= allListings.length %> stays found</span>
        </div>
        <div class="mt-2 text-end">
            <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-xmark me-1"></i> Clear Filters
            </a>
        </div>
    </div>
<% } %>

<!-- Listings Cards Grid -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-2 g-2 g-md-4 mt-1 mb-5">
    <% if (allListings && allListings.length > 0) { %>
        <% for(let listing of allListings) { %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="stay-card">
                        <div class="stay-card-img-wrapper">
                            <img src="<%= listing.image.url %>" class="stay-card-img" alt="<%= listing.title %>">
                            <span class="stay-badge-location">
                                <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %>
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 75%;"><%= listing.title %></h5>
                                <span class="badge bg-warning text-dark px-2 py-1"><i class="fa-solid fa-star me-1"></i>4.9</span>
                            </div>
                            <p class="text-secondary small text-truncate mb-3"><%= listing.description || "Handpicked luxury stay experience curated for your perfect getaway." %></p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <span class="stay-card-price">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span>
                                    <span class="text-secondary fw-normal small">/ night</span>
                                    <i class="tax-info text-danger small fw-semibold" style="display: none;">&nbsp;(+18% GST)</i>
                                </div>
                                <span class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-bold">View Stay</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    <% } else { %>
        <div class="col-12 text-center py-5">
            <div class="my-4">
                <i class="fa-solid fa-compass-drafting text-danger display-4 mb-3"></i>
                <h4 class="fw-bold text-dark">No stays match your search criteria</h4>
                <p class="text-secondary">Try searching for a different destination, city, or category.</p>
                <a href="/listings" class="btn btn-danger rounded-pill px-4 mt-2">Explore All Stays</a>
            </div>
        </div>
    <% } %>
</div>   

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    if (taxSwitch) {
        taxSwitch.addEventListener("click", () => {
           let taxInfo = document.getElementsByClassName("tax-info");
           for (let info of taxInfo) {
            if (info.style.display !== "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
           }
        });
    }
</script>
