<% layout("layouts/boilerplate") -%>

<style>
.form-page-container {
    padding: 2.5rem 1rem;
    min-height: 80vh;
}

.form-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.8rem;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    max-width: 740px;
    margin: 0 auto;
    padding: 3rem 2.5rem;
    position: relative;
    overflow: hidden;
}

@media (max-width: 767px) {
    .form-page-container {
        padding: 1rem 0.5rem;
    }
    .form-card {
        padding: 1.25rem 1rem !important;
        border-radius: 1.2rem !important;
    }
    .form-header-badge {
        font-size: 0.75rem !important;
        padding: 0.25rem 0.75rem !important;
        margin-bottom: 0.4rem !important;
    }
    .form-main-heading {
        font-size: 1.35rem !important;
    }
    .form-label-custom {
        font-size: 0.8rem !important;
        margin-bottom: 0.25rem !important;
    }
    .form-control-custom {
        padding: 0.5rem 0.85rem !important;
        font-size: 0.88rem !important;
        border-radius: 0.85rem !important;
    }
    .file-upload-box {
        padding: 0.85rem 0.75rem !important;
        border-radius: 0.85rem !important;
    }
    .btn-form-submit, .btn-form-cancel {
        font-size: 0.82rem !important;
        padding: 0.5rem 0.85rem !important;
        border-radius: 0.75rem !important;
        white-space: nowrap !important;
        width: auto !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .form-select.form-control-custom option {
        font-size: 0.82rem !important;
        padding: 0.4rem 0.6rem !important;
    }
}

.form-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, #fe424d 0%, #ff758c 100%);
}

.form-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff1f2;
    color: #fe424d;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 0.75rem;
}

.form-main-heading {
    font-size: 1.85rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
}

.form-label-custom {
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.form-control-custom {
    border: 1.5px solid #e2e8f0;
    border-radius: 1rem;
    padding: 0.75rem 1.1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #0f172a;
    background: #f8fafc;
    transition: all 0.25s ease;
}

.form-control-custom:focus {
    background: #ffffff;
    border-color: #fe424d;
    box-shadow: 0 0 0 4px rgba(254, 66, 77, 0.12);
    outline: none;
}

.file-upload-box {
    border: 2px dashed #cbd5e1;
    border-radius: 1.25rem;
    padding: 1.5rem;
    text-align: center;
    background: #f8fafc;
    transition: all 0.25s ease;
    cursor: pointer;
}

.file-upload-box:hover {
    border-color: #fe424d;
    background: #fff1f2;
}

.btn-form-submit {
    background: linear-gradient(135deg, #fe424d 0%, #e0313c 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 1.05rem;
    border-radius: 1rem;
    padding: 0.9rem 2.2rem;
    border: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(254, 66, 77, 0.35);
}

.btn-form-submit:hover {
    background: linear-gradient(135deg, #e0313c 0%, #c82333 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(254, 66, 77, 0.5);
    color: #ffffff;
}

.btn-form-cancel {
    border: 1.5px solid #cbd5e1;
    color: #64748b;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 1rem;
    padding: 0.85rem 1.8rem;
    background: transparent;
    text-decoration: none;
    transition: all 0.2s ease;
}

.btn-form-cancel:hover {
    background: #f1f5f9;
    color: #0f172a;
}
/* Custom Styled Luxury Dropdown */
.custom-category-dropdown {
    position: relative;
    width: 100%;
}

.custom-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 1.2rem;
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.14);
    z-index: 1050;
    max-height: 240px;
    overflow-y: auto;
    padding: 0.4rem;
}

.custom-dropdown-item {
    padding: 0.6rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s ease;
}

.custom-dropdown-item:hover, .custom-dropdown-item.active {
    background: #fff1f2;
    color: #fe424d;
    font-weight: 700;
}

.transition-icon {
    transition: transform 0.25s ease;
}

.transition-icon.rotate-180 {
    transform: rotate(180deg);
}

@media (max-width: 767px) {
    .custom-dropdown-menu {
        border-radius: 1rem !important;
        max-height: 200px !important;
        padding: 0.3rem !important;
    }
    .custom-dropdown-item {
        padding: 0.5rem 0.75rem !important;
        font-size: 0.84rem !important;
        border-radius: 0.65rem !important;
    }
}
</style>

<div class="form-page-container">
    <div class="form-card">
        <div class="mb-4">
            <span class="form-header-badge">
                <i class="fa-solid fa-house-chimney-window"></i> Become a Host
            </span>
            <h2 class="form-main-heading">Create Your New Haven</h2>
            <p class="text-secondary small mb-0">Share your property with travelers around the world and start earning.</p>
        </div>

        <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label-custom">
                    <i class="fa-solid fa-heading text-danger"></i> Title
                </label>
                <input name="listing[title]" id="title" placeholder="e.g. Luxury Beachfront Villa with Private Infinity Pool" type="text" class="form-control form-control-custom" required>
                <div class="valid-feedback ms-1">Title looks catchy!</div>
                <div class="invalid-feedback ms-1">Please provide a descriptive title.</div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label-custom">
                    <i class="fa-solid fa-align-left text-danger"></i> Description
                </label>
                <textarea name="listing[description]" id="description" rows="4" placeholder="Describe the ambiance, key amenities, scenic views, and unique experiences your stay offers..." class="form-control form-control-custom" required></textarea>
                <div class="invalid-feedback ms-1">Please write a short description.</div>
            </div>

            <!-- Category & Price -->
            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="category" class="form-label-custom">
                        <i class="fa-solid fa-layer-group text-danger"></i> Category
                    </label>
                    <div class="custom-category-dropdown position-relative">
                        <input type="hidden" name="listing[category]" id="categoryInput" value="Trending">
                        <button type="button" id="categoryDropdownBtn" class="form-control form-control-custom d-flex align-items-center justify-content-between text-start cursor-pointer">
                            <span id="selectedCategoryLabel">🔥 Trending</span>
                            <i class="fa-solid fa-chevron-down text-secondary fs-6 transition-icon"></i>
                        </button>
                        
                        <div id="categoryDropdownMenu" class="custom-dropdown-menu d-none">
                            <div class="custom-dropdown-item active" data-value="Trending"><span>🔥 Trending</span></div>
                            <div class="custom-dropdown-item" data-value="Rooms"><span>🛏️ Rooms</span></div>
                            <div class="custom-dropdown-item" data-value="Iconic cities"><span>🏙️ Iconic Cities</span></div>
                            <div class="custom-dropdown-item" data-value="Mountains"><span>🏔️ Mountains</span></div>
                            <div class="custom-dropdown-item" data-value="Castles"><span>🏰 Castles</span></div>
                            <div class="custom-dropdown-item" data-value="Pools"><span>🏊‍♂️ Amazing Pools</span></div>
                            <div class="custom-dropdown-item" data-value="Camping"><span>⛺ Camping</span></div>
                            <div class="custom-dropdown-item" data-value="Farms"><span>🚜 Farms</span></div>
                            <div class="custom-dropdown-item" data-value="Arctic"><span>❄️ Arctic</span></div>
                            <div class="custom-dropdown-item" data-value="Beachfront"><span>🏖️ Beachfront</span></div>
                        </div>
                    </div>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="price" class="form-label-custom">
                        <i class="fa-solid fa-indian-rupee-sign text-danger"></i> Price (per night)
                    </label>
                    <input name="listing[price]" id="price" placeholder="1200" type="number" min="1" class="form-control form-control-custom" required>
                    <div class="invalid-feedback ms-1">Please enter a valid price amount.</div>
                </div>
            </div>

            <!-- Country & Location -->
            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="country" class="form-label-custom">
                        <i class="fa-solid fa-globe text-danger"></i> Country
                    </label>
                    <input name="listing[country]" id="country" placeholder="e.g. India" type="text" class="form-control form-control-custom" required>
                    <div class="invalid-feedback ms-1">Please specify the country.</div>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="location" class="form-label-custom">
                        <i class="fa-solid fa-location-dot text-danger"></i> Location / City
                    </label>
                    <input name="listing[location]" id="location" placeholder="e.g. Goa" type="text" class="form-control form-control-custom" required>
                    <div class="invalid-feedback ms-1">Please specify the city or location.</div>
                </div>
            </div>

            <!-- Image Upload -->
            <div class="mb-4">
                <label for="image" class="form-label-custom">
                    <i class="fa-solid fa-image text-danger"></i> Upload Listing Cover Image
                </label>
                <div class="file-upload-box">
                    <i class="fa-solid fa-cloud-arrow-up text-danger display-6 mb-2"></i>
                    <p class="fw-semibold text-dark mb-1">Click to select high-resolution property photo</p>
                    <small class="text-secondary d-block mb-3">Supports JPG, PNG, WEBP files</small>
                    <input name="listing[image]" id="image" type="file" class="form-control form-control-custom" required>
                    <div class="invalid-feedback ms-1 mt-2">Please upload a cover image for your listing.</div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-flex align-items-center gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-form-submit">
                    <i class="fa-solid fa-plus me-1"></i>Publish Listing
                </button>
                <a href="/listings" class="btn-form-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const dropdownBtn = document.getElementById("categoryDropdownBtn");
    const dropdownMenu = document.getElementById("categoryDropdownMenu");
    const categoryInput = document.getElementById("categoryInput");
    const labelSpan = document.getElementById("selectedCategoryLabel");

    if (dropdownBtn && dropdownMenu) {
        dropdownBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            dropdownMenu.classList.toggle("d-none");
            const icon = dropdownBtn.querySelector(".transition-icon");
            if (icon) icon.classList.toggle("rotate-180");
        });

        document.querySelectorAll(".custom-dropdown-item").forEach(item => {
            item.addEventListener("click", () => {
                const val = item.getAttribute("data-value");
                if (categoryInput) categoryInput.value = val;
                if (labelSpan) labelSpan.innerHTML = item.innerHTML;
                dropdownMenu.classList.add("d-none");
                
                document.querySelectorAll(".custom-dropdown-item").forEach(i => i.classList.remove("active"));
                item.classList.add("active");
                const icon = dropdownBtn.querySelector(".transition-icon");
                if (icon) icon.classList.remove("rotate-180");
            });
        });

        document.addEventListener("click", (e) => {
            if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                dropdownMenu.classList.add("d-none");
                const icon = dropdownBtn.querySelector(".transition-icon");
                if (icon) icon.classList.remove("rotate-180");
            }
        });
    }
});
</script>
