<% layout("layouts/boilerplate") -%>

<style>
.show-page-container {
    padding: 2rem 0 4rem 0;
}

.show-header-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.6px;
    margin-bottom: 0.5rem;
}

.show-meta-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.show-meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
    background: #f1f5f9;
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
}

.show-host-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: #0f172a;
}

.show-host-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fe424d;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
}

.show-hero-img-wrapper {
    position: relative;
    border-radius: 1.6rem;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.1);
    margin-bottom: 1.5rem;
    background: #0f172a;
    width: 100%;
    height: 380px;
}

.show-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}

.show-badge-overlay {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(10px);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.45rem 1.1rem;
    border-radius: 2rem;
    z-index: 10;
}

.show-details-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.6rem;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
}

.booking-floating-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 1.8rem;
    padding: 2rem;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    position: sticky;
    top: 6rem;
}

.booking-price-header {
    font-size: 1.75rem;
    font-weight: 800;
    color: #0f172a;
}

.amenity-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.6rem 1rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: #334155;
}

.review-card {
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    background: #ffffff;
    transition: all 0.25s ease;
}

.review-card:hover {
    box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    transform: translateY(-2px);
}

@media (max-width: 767px) {
    .show-page-container {
        padding: 1rem 0 3rem 0;
    }
    .show-header-title {
        font-size: 1.35rem !important;
        line-height: 1.3;
        margin-bottom: 0.4rem;
    }
    .show-meta-bar {
        gap: 0.35rem !important;
        margin-bottom: 0.85rem !important;
    }
    .show-meta-pill {
        font-size: 0.72rem !important;
        padding: 0.25rem 0.6rem !important;
        max-width: 100% !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }
    .show-host-badge {
        font-size: 0.78rem !important;
        width: 100%;
        margin-top: 0.25rem;
    }
    .show-host-avatar {
        width: 26px !important;
        height: 26px !important;
        font-size: 0.75rem !important;
    }
    .show-hero-img-wrapper {
        height: 220px !important;
        border-radius: 1.2rem !important;
        margin-bottom: 1rem !important;
    }
    .show-badge-overlay {
        display: none !important;
    }
    .show-details-card {
        padding: 1rem !important;
        border-radius: 1.2rem !important;
        margin-bottom: 0.75rem !important;
    }
    .booking-floating-card {
        padding: 1rem !important;
        border-radius: 1.2rem !important;
        position: relative;
        top: 0;
        margin-top: 0 !important;
    }
    .booking-price-header {
        font-size: 1.3rem !important;
    }
    .amenity-chip {
        font-size: 0.72rem !important;
        padding: 0.35rem 0.65rem !important;
        border-radius: 10px !important;
        gap: 0.35rem !important;
    }
    .amenity-chip i {
        font-size: 0.85rem !important;
    }
    .show-details-card h4 {
        font-size: 1.15rem !important;
    }
    .booking-floating-card .btn-danger {
        padding: 0.55rem 1rem !important;
        font-size: 0.9rem !important;
        margin-bottom: 0.5rem !important;
    }
    .booking-floating-card .bg-light {
        padding: 0.6rem 0.85rem !important;
        margin-bottom: 0.85rem !important;
    }
    .show-details-card .btn-dark, .show-details-card .btn-outline-danger {
        font-size: 0.82rem !important;
        padding: 0.45rem 0.75rem !important;
        white-space: nowrap !important;
    }
    .show-details-card .btn-danger:not(.booking-floating-card .btn-danger) {
        font-size: 0.85rem !important;
        padding: 0.55rem 1.25rem !important;
        border-radius: 0.85rem !important;
        width: 100% !important;
        text-align: center !important;
        box-shadow: 0 4px 14px rgba(254, 66, 77, 0.25) !important;
    }
    .starability-slot {
        min-height: 32px !important;
        height: 32px !important;
        margin-bottom: 0.5rem !important;
    }
    .show-details-card textarea.form-control-custom {
        padding: 0.55rem 0.85rem !important;
        font-size: 0.88rem !important;
        border-radius: 0.85rem !important;
    }
}

.starability-slot {
    min-height: 32px !important;
    height: 32px !important;
    margin-bottom: 0.5rem !important;
}
</style>

<div class="show-page-container">
    <!-- Header Section -->
    <div class="mb-4">
        <h1 class="show-header-title"><%= listing.title %></h1>
        <div class="show-meta-bar">
            <span class="show-meta-pill text-truncate" style="max-width: 100%;">
                <i class="fa-solid fa-location-dot text-danger flex-shrink-0"></i> 
                <span class="text-truncate"><%= listing.location %><% if(listing.country) { %>, <%= listing.country %><% } %></span>
            </span>
            <%
                let avgRating = "New";
                let numReviews = (listing.reviews && listing.reviews.length) ? listing.reviews.length : 0;
                if (numReviews > 0) {
                    let sum = 0;
                    for (let r of listing.reviews) {
                        sum += (r.rating || 5);
                    }
                    avgRating = (sum / numReviews).toFixed(1);
                }
            %>
            <span class="show-meta-pill">
                <i class="fa-solid fa-star text-warning me-1"></i><%= avgRating %><% if (numReviews > 0) { %> (<%= numReviews %> <%= numReviews === 1 ? 'review' : 'reviews' %>)<% } %>
            </span>
            <span class="show-meta-pill">
                <i class="fa-solid fa-layer-group text-primary me-1"></i><%= listing.category || 'Trending' %>
            </span>
            <div class="show-host-badge ms-auto">
                <div class="show-host-avatar"><%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %></div>
                <span>Hosted by <span class="text-danger"><%= listing.owner ? listing.owner.username : 'Host' %></span></span>
            </div>
        </div>
    </div>

    <!-- Main Content 2-Column Grid -->
    <div class="row g-3 g-md-4 mb-3 mb-md-5">
        <!-- Left Details & Image Column -->
        <div class="col-lg-7">
            <!-- Hero Image Showcase inside Left Column -->
            <div class="show-hero-img-wrapper">
                <span class="show-badge-overlay">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %>
                </span>
                <img src="<%= listing.image.url %>" class="show-hero-img" alt="<%= listing.title %>">
            </div>

            <div class="show-details-card mb-4">
                <h4 class="fw-bold text-dark mb-3">About this Haven</h4>
                <p class="text-secondary fs-6 lh-lg mb-4"><%= listing.description %></p>

                <hr class="my-4 text-secondary opacity-25">

                <h5 class="fw-bold text-dark mb-3">What this stay offers</h5>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="amenity-chip"><i class="fa-solid fa-wifi text-danger"></i> High-Speed WiFi</span>
                    <span class="amenity-chip"><i class="fa-solid fa-water-ladder text-info"></i> Swimming Pool</span>
                    <span class="amenity-chip"><i class="fa-solid fa-square-parking text-primary"></i> Free On-Site Parking</span>
                    <span class="amenity-chip"><i class="fa-solid fa-snowflake text-primary"></i> Air Conditioning</span>
                    <span class="amenity-chip"><i class="fa-solid fa-shield-heart text-danger"></i> 100% Superhost Guarantee</span>
                </div>

                <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                    <hr class="my-4 text-secondary opacity-25">
                    <div class="d-flex align-items-center gap-2">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-3 py-2 fw-bold text-nowrap flex-fill text-center">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline flex-fill">
                            <button class="btn btn-outline-danger rounded-pill px-3 py-2 fw-bold text-nowrap w-100">
                                <i class="fa-solid fa-trash me-1"></i> Delete Listing
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Right Floating Booking Sidebar -->
        <div class="col-lg-5">
            <div class="booking-floating-card">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                        <span class="booking-price-header">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                        <span class="text-secondary fw-semibold">/ night</span>
                    </div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill fw-bold small">
                        <i class="fa-solid fa-bolt me-1"></i> Instant Book
                    </span>
                </div>

                <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm">
                    <!-- Date Range Selection -->
                    <div class="p-3 bg-light rounded-4 border mb-3">
                        <div class="row g-2 mb-2">
                            <div class="col-6 border-end">
                                <label for="checkInDate" class="form-label fw-bold text-dark extra-small mb-1 uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">CHECK-IN</label>
                                <input type="text" id="checkInDate" name="booking[checkIn]" class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark px-0 shadow-none cursor-pointer" placeholder="Select check-in" required readonly>
                            </div>
                            <div class="col-6">
                                <label for="checkOutDate" class="form-label fw-bold text-dark extra-small mb-1 uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">CHECK-OUT</label>
                                <input type="text" id="checkOutDate" name="booking[checkOut]" class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark px-0 shadow-none cursor-pointer" placeholder="Select check-out" required readonly>
                            </div>
                        </div>
                        <div class="border-top pt-2 mt-1">
                            <label for="guestCount" class="form-label fw-bold text-dark extra-small mb-1 uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">GUESTS</label>
                            <select id="guestCount" name="booking[guests]" class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark px-0 shadow-none">
                                <option value="1" selected>1 Guest</option>
                                <option value="2">2 Guests</option>
                                <option value="3">3 Guests</option>
                                <option value="4">4 Guests</option>
                                <option value="5">5+ Guests</option>
                            </select>
                        </div>
                    </div>

                    <!-- Dynamic Price Breakdown -->
                    <div class="p-3 bg-light rounded-4 border mb-4">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span id="pricePerNightLabel">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %> x <span id="nightsVal">1</span> night</span>
                            <span id="basePriceVal">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                        </div>
                        <div class="d-flex justify-content-between small text-danger fw-semibold mb-2">
                            <span>GST Tax (18%)</span>
                            <span id="gstVal">+&#8377;<%= listing.price ? Math.round(listing.price * 0.18).toLocaleString("en-IN") : "0" %></span>
                        </div>
                        <hr class="my-2 text-secondary opacity-25">
                        <div class="d-flex justify-content-between text-dark fw-bold pt-1">
                            <span>Total Due</span>
                            <span id="totalPriceVal" class="fs-5 text-danger">&#8377;<%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : "0" %></span>
                        </div>
                    </div>

                    <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                        <button type="button" class="btn btn-secondary btn-lg w-100 rounded-pill fw-bold py-3 mb-3" disabled>
                            <i class="fa-solid fa-house-user me-2"></i> You Own This Stay
                        </button>
                    <% } else { %>
                        <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold py-3 shadow mb-3">
                            <i class="fa-solid fa-bolt me-2"></i> Reserve This Haven
                        </button>
                    <% } %>
                    <p class="text-center text-secondary small mb-0"><i class="fa-solid fa-shield-halved me-1 text-success"></i> Free cancellation before check-in</p>
                </form>
            </div>
        </div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const nightlyPrice = <%= listing.price || 0 %>;
    const nightsVal = document.getElementById("nightsVal");
    const basePriceVal = document.getElementById("basePriceVal");
    const gstVal = document.getElementById("gstVal");
    const totalPriceVal = document.getElementById("totalPriceVal");

    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);

    const dayAfter = new Date(tomorrow);
    dayAfter.setDate(dayAfter.getDate() + 1);

    function updatePriceCalculation() {
        if (checkInFP && checkOutFP && checkInFP.selectedDates[0] && checkOutFP.selectedDates[0]) {
            const cin = checkInFP.selectedDates[0];
            const cout = checkOutFP.selectedDates[0];

            if (cout > cin) {
                const diffTime = cout.getTime() - cin.getTime();
                const totalNights = Math.max(1, Math.ceil(diffTime / (1000 * 3600 * 24)));

                const basePrice = nightlyPrice * totalNights;
                const gstAmount = Math.round(basePrice * 0.18);
                const totalPrice = basePrice + gstAmount;

                nightsVal.innerText = totalNights;
                basePriceVal.innerText = "₹" + basePrice.toLocaleString("en-IN");
                gstVal.innerText = "+₹" + gstAmount.toLocaleString("en-IN");
                totalPriceVal.innerText = "₹" + totalPrice.toLocaleString("en-IN");
            }
        }
    }

    const checkInFP = flatpickr("#checkInDate", {
        minDate: "today",
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d-m-Y",
        altInputClass: "form-control form-control-sm border-0 bg-transparent fw-bold text-dark px-0 shadow-none cursor-pointer",
        defaultDate: tomorrow,
        onChange: function(selectedDates) {
            if (selectedDates[0]) {
                const minCout = new Date(selectedDates[0]);
                minCout.setDate(minCout.getDate() + 1);
                checkOutFP.set("minDate", minCout);
                if (!checkOutFP.selectedDates[0] || checkOutFP.selectedDates[0] <= selectedDates[0]) {
                    checkOutFP.setDate(minCout);
                }
                updatePriceCalculation();
            }
        }
    });

    const checkOutFP = flatpickr("#checkOutDate", {
        minDate: dayAfter,
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d-m-Y",
        altInputClass: "form-control form-control-sm border-0 bg-transparent fw-bold text-dark px-0 shadow-none cursor-pointer",
        defaultDate: dayAfter,
        onChange: function() {
            updatePriceCalculation();
        }
    });

    updatePriceCalculation();
});
</script>
    </div>

    <!-- Reviews Section -->
    <div class="border-top pt-3 pt-md-5">
        <div class="row">
            <!-- Review Form -->
            <% if(currUser) { %>
                <div class="col-lg-6 mb-4">
                    <div class="show-details-card">
                        <h4 class="fw-bold text-dark mb-3"><i class="fa-regular fa-comment-dots text-danger me-2"></i>Leave a Review</h4>
                        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                            <div class="mb-3">
                                <label for="rating" class="form-label fw-bold text-dark small">Select Rating</label>
                                <fieldset class="starability-slot">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label fw-bold text-dark small">Your Experience</label>
                                <textarea name="review[comment]" id="comment" rows="3" placeholder="Share your experience staying at this haven..." class="form-control form-control-custom" required></textarea>
                                <div class="invalid-feedback ms-1">Please write a comment for your review.</div>
                            </div>
                            <button class="btn btn-danger rounded-pill px-4 fw-bold">Submit Review</button>
                        </form>
                    </div>
                </div>
            <% } %>

            <!-- All Reviews List -->
            <div class="<%= currUser ? 'col-lg-6' : 'col-12' %>">
                <% if(listing.reviews && listing.reviews.length > 0) { %>
                    <h4 class="fw-bold text-dark mb-4">Guest Reviews (<%= listing.reviews.length %>)</h4>
                    <div class="row g-3">
                        <% for(review of listing.reviews) { %>
                            <div class="col-12">
                                <div class="card review-card p-3">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="show-host-avatar bg-dark" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                    <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                                                </div>
                                                <h6 class="fw-bold text-dark mb-0">@<%= review.author ? review.author.username : 'Anonymous' %></h6>
                                            </div>
                                            <p class="starability-result mb-0" data-rating="<%= review.rating %>"></p>
                                        </div>
                                        <p class="card-text text-secondary small mb-2"><%= review.comment %></p>

                                        <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="text-end mt-2">
                                                <button class="btn btn-sm btn-link text-danger text-decoration-none p-0 fw-bold small">
                                                    <i class="fa-solid fa-trash me-1"></i>Delete Review
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-4 bg-light rounded-4 border">
                        <i class="fa-regular fa-comments text-secondary display-5 mb-2"></i>
                        <p class="text-secondary fw-semibold mb-0">No reviews yet. Be the first traveler to leave a review!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
