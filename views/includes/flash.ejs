<% if ((success && success.length) || (error && error.length)) { %>
<style>
/* Floating Modern Alert Toast Styling */
.toast-floating-container {
    position: fixed;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1100;
    width: 90%;
    max-width: 500px;
    pointer-events: none;
}

.custom-alert-toast {
    pointer-events: auto;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    border-radius: 1.25rem;
    padding: 0.9rem 1.25rem;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.16);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    animation: toastSlideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: all 0.3s ease;
    margin-bottom: 0.75rem;
}

.custom-alert-toast.toast-success {
    border: 1.5px solid #a7f3d0;
    background: rgba(240, 253, 244, 0.98);
}

.custom-alert-toast.toast-danger {
    border: 1.5px solid #fecdd3;
    background: rgba(255, 241, 242, 0.98);
}

.toast-icon-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.05rem;
}

.toast-success .toast-icon-circle {
    background: #10b981;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
}

.toast-danger .toast-icon-circle {
    background: #fe424d;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(254, 66, 77, 0.35);
}

.toast-message-content {
    flex-grow: 1;
    text-align: left;
}

.toast-title {
    font-weight: 800;
    font-size: 0.88rem;
    margin: 0 0 0.15rem 0;
    line-height: 1.2;
}

.toast-success .toast-title {
    color: #065f46;
}

.toast-danger .toast-title {
    color: #9f1239;
}

.toast-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #334155;
    margin: 0;
    line-height: 1.3;
}

.toast-close-btn {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 0.95rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
}

.toast-close-btn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #0f172a;
}

@keyframes toastSlideDown {
    from {
        opacity: 0;
        transform: translateY(-25px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.toast-hiding {
    opacity: 0 !important;
    transform: translateY(-20px) scale(0.95) !important;
}
</style>

<div class="toast-floating-container">
    <% if(success && success.length) { %>
        <div class="custom-alert-toast toast-success" id="successToast">
            <div class="toast-icon-circle">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="toast-message-content">
                <h6 class="toast-title">Success</h6>
                <p class="toast-text"><%= success %></p>
            </div>
            <button type="button" class="toast-close-btn" onclick="dismissToast('successToast')" title="Close notification">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    <% } %>

    <% if(error && error.length) { %>
        <div class="custom-alert-toast toast-danger" id="errorToast">
            <div class="toast-icon-circle">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="toast-message-content">
                <h6 class="toast-title">Attention</h6>
                <p class="toast-text"><%= error %></p>
            </div>
            <button type="button" class="toast-close-btn" onclick="dismissToast('errorToast')" title="Close notification">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    <% } %>
</div>

<script>
function dismissToast(id) {
    const el = document.getElementById(id);
    if (el) {
        el.classList.add("toast-hiding");
        setTimeout(() => el.remove(), 300);
    }
}

document.addEventListener("DOMContentLoaded", () => {
    // Auto dismiss after 5 seconds
    setTimeout(() => {
        const toasts = document.querySelectorAll(".custom-alert-toast");
        toasts.forEach(t => {
            t.classList.add("toast-hiding");
            setTimeout(() => t.remove(), 300);
        });
    }, 5000);
});
</script>
<% } %>