<% if ((success && success.length) || (error && error.length)) { %>
<style>
/* Instant Floating Alert Toast Styling */
.toast-floating-container {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999999 !important;
    width: 90%;
    max-width: 480px;
    pointer-events: none;
}

.custom-alert-toast {
    pointer-events: auto;
    background: #ffffff;
    border-radius: 1.2rem;
    padding: 0.85rem 1.15rem;
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.22);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    animation: toastPopInstant 0.2s ease-out forwards;
    transition: opacity 0.2s ease, transform 0.2s ease;
    margin-bottom: 0.6rem;
}

.custom-alert-toast.toast-success {
    border: 1.5px solid #10b981;
    background: #f0fdf4;
}

.custom-alert-toast.toast-danger {
    border: 1.5px solid #fe424d;
    background: #fff1f2;
}

.toast-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
}

.toast-success .toast-icon-circle {
    background: #10b981;
    color: #ffffff;
}

.toast-danger .toast-icon-circle {
    background: #fe424d;
    color: #ffffff;
}

.toast-message-content {
    flex-grow: 1;
    text-align: left;
}

.toast-title {
    font-weight: 800;
    font-size: 0.88rem;
    margin: 0 0 0.15rem 0;
    line-height: 1.2;
}

.toast-success .toast-title {
    color: #065f46;
}

.toast-danger .toast-title {
    color: #9f1239;
}

.toast-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #334155;
    margin: 0;
    line-height: 1.3;
}

.toast-close-btn {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 0.95rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease;
    flex-shrink: 0;
}

.toast-close-btn:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #0f172a;
}

@keyframes toastPopInstant {
    from {
        opacity: 0;
        transform: translateY(-15px) scale(0.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.toast-hiding {
    opacity: 0 !important;
    transform: translateY(-15px) scale(0.96) !important;
}
</style>

<div class="toast-floating-container">
    <% if(success && success.length) { %>
        <% let successMsg = Array.isArray(success) ? success[success.length - 1] : success; %>
        <div class="custom-alert-toast toast-success" id="successToast">
            <div class="toast-icon-circle">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="toast-message-content">
                <h6 class="toast-title">Success</h6>
                <p class="toast-text"><%= successMsg %></p>
            </div>
            <button type="button" class="toast-close-btn" onclick="dismissToast('successToast')" title="Close notification">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    <% } %>

    <% if(error && error.length) { %>
        <% let errorMsg = Array.isArray(error) ? error[error.length - 1] : error; %>
        <div class="custom-alert-toast toast-danger" id="errorToast">
            <div class="toast-icon-circle">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="toast-message-content">
                <h6 class="toast-title">Attention</h6>
                <p class="toast-text"><%= errorMsg %></p>
            </div>
            <button type="button" class="toast-close-btn" onclick="dismissToast('errorToast')" title="Close notification">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    <% } %>
</div>

<script>
function dismissToast(id) {
    const el = document.getElementById(id);
    if (el) {
        el.classList.add("toast-hiding");
        setTimeout(() => el.remove(), 200);
    }
}

// Execute auto-dismiss immediately without waiting for DOMContentLoaded
setTimeout(() => {
    const toasts = document.querySelectorAll(".custom-alert-toast");
    toasts.forEach(t => {
        t.classList.add("toast-hiding");
        setTimeout(() => t.remove(), 200);
    });
}, 4000);
</script>
<% } %>