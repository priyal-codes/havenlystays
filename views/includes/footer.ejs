<style>
/* Modern Dark Compact Luxury Footer Styling */
.main-footer {
    background: #0f172a;
    color: #94a3b8;
    padding-top: 2.25rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid #1e293b;
    margin-top: auto;
}

.footer-brand-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    letter-spacing: -0.5px;
}

.footer-brand-title i {
    color: #fe424d;
}

.footer-brand-text {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-top: 0.5rem;
    max-width: 300px;
}

.footer-heading {
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.2px;
}

.footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.footer-links-list li {
    margin-bottom: 0.45rem;
}

.footer-links-list a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

.footer-links-list a:hover {
    color: #fe424d;
}

.footer-social-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #1e293b;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    margin-right: 0.4rem;
    transition: all 0.2s ease;
    text-decoration: none;
}

.footer-social-icon:hover {
    background: #fe424d;
    color: #ffffff;
    transform: translateY(-2px);
}

.footer-bottom-bar {
    border-top: 1px solid #1e293b;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.82rem;
}

.footer-legal-links {
    display: flex;
    gap: 1.25rem;
}

.footer-legal-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s ease;
}

.footer-legal-links a:hover {
    color: #ffffff;
}

.footer-currency-badge {
    background: #1e293b;
    color: #ffffff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.78rem;
}

@media (max-width: 767px) {
    .main-footer {
        padding-top: 1.75rem;
        padding-bottom: 1.25rem;
    }
    .footer-brand-text {
        font-size: 0.8rem;
        margin-top: 0.35rem;
    }
    .footer-bottom-bar {
        margin-top: 1.25rem;
        padding-top: 1rem;
        flex-direction: column;
        text-align: center;
        gap: 0.5rem;
    }
}
</style>

<footer class="main-footer">
    <div class="container">
        <div class="row g-3">
            <!-- Brand Column -->
            <div class="col-lg-4 col-md-12 mb-2 mb-lg-0">
                <a href="/" class="footer-brand-title">
                    <i class="fa-regular fa-compass"></i>
                    <span>Havenly Stays</span>
                </a>
                <p class="footer-brand-text font-serif-italic mb-3">
                    "Handpicked luxury villas, beachfront retreats, and chalets designed for your perfect getaway."
                </p>
                <div class="d-flex align-items-center">
                    <a href="https://facebook.com" target="_blank" class="footer-social-icon" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://instagram.com" target="_blank" class="footer-social-icon" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://linkedin.com" target="_blank" class="footer-social-icon" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="https://github.com/priyal-codes/havenlystays" target="_blank" class="footer-social-icon" title="GitHub"><i class="fa-brands fa-github"></i></a>
                </div>
            </div>

            <!-- Links 3 Columns Grid -->
            <div class="col-lg-8 col-md-12">
                <div class="row g-3">
                    <!-- Explore Column -->
                    <div class="col-4">
                        <h6 class="footer-heading">Explore</h6>
                        <ul class="footer-links-list">
                            <li><a href="/listings">All Havens</a></li>
                            <li><a href="/listings?category=Beachfront">Beachfront</a></li>
                            <li><a href="/listings?category=Mountains">Mountain Chalets</a></li>
                        </ul>
                    </div>

                    <!-- Hosting Column -->
                    <div class="col-4">
                        <h6 class="footer-heading">Hosting</h6>
                        <ul class="footer-links-list">
                            <li><a href="/listings/new">Become a Host</a></li>
                            <li><a href="/listings/new">Protection</a></li>
                            <li><a href="/listings/new">Community</a></li>
                        </ul>
                    </div>

                    <!-- Support Column -->
                    <div class="col-4">
                        <h6 class="footer-heading">Support</h6>
                        <ul class="footer-links-list">
                            <li><a href="/listings">Help Center</a></li>
                            <li><a href="/listings">Cancellation</a></li>
                            <li><a href="/listings">Contact Us</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="footer-bottom-bar">
            <div>
                &copy; <%= new Date().getFullYear() %> Havenly Stays Inc. All rights reserved.
            </div>
            <div class="footer-legal-links">
                <a href="/listings">Privacy</a>
                <a href="/listings">Terms</a>
                <a href="/listings">Sitemap</a>
            </div>
            <div class="footer-currency-badge">
                <i class="fa-solid fa-globe me-1"></i> English • ₹ INR
            </div>
        </div>
    </div>
</footer>