<% layout("layouts/boilerplate") -%>

<style>
.trips-container {
    padding: 2.5rem 0 4rem 0;
}

.trips-header {
    margin-bottom: 2.5rem;
}

.trips-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.6px;
    margin-bottom: 0.4rem;
}

.trips-sub {
    font-size: 1rem;
    color: #64748b;
    font-weight: 500;
}

.booking-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.6rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.booking-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.1);
}

.booking-img-wrapper {
    position: relative;
    height: 200px;
    width: 100%;
    overflow: hidden;
    background: #0f172a;
}

.booking-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.booking-status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    backdrop-filter: blur(8px);
    z-index: 10;
}

.status-confirmed {
    background: rgba(16, 185, 129, 0.9);
    color: #ffffff;
}

.status-cancelled {
    background: rgba(239, 68, 68, 0.9);
    color: #ffffff;
}

.booking-body {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.booking-stay-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.4rem;
    text-decoration: none;
    line-height: 1.3;
}

.booking-stay-title:hover {
    color: #fe424d;
}

.booking-location {
    font-size: 0.88rem;
    color: #64748b;
    font-weight: 600;
    margin-bottom: 1.25rem;
}

.date-pill-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1.1rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.25rem;
}

.date-item-label {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #94a3b8;
    letter-spacing: 0.5px;
}

.date-item-val {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
}

.price-summary-box {
    border-top: 1px dashed #e2e8f0;
    padding-top: 1rem;
    margin-top: auto;
}

.empty-trips-card {
    background: #ffffff;
    border: 1px dashed #cbd5e1;
    border-radius: 2rem;
    padding: 4rem 2rem;
    text-align: center;
    max-width: 540px;
    margin: 2rem auto;
}

.empty-trips-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #fff1f2;
    color: #fe424d;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
}
</style>

<div class="trips-container">
    <div class="trips-header">
        <h1 class="trips-title"><i class="fa-solid fa-plane-departure text-danger me-2"></i>My Trips & Reservations</h1>
        <p class="trips-sub">Manage your booked stay reservations, view check-in details, and track your travel receipts.</p>
    </div>

    <% if (bookings && bookings.length > 0) { %>
        <div class="row g-4">
            <% for (let booking of bookings) { %>
                <div class="col-lg-4 col-md-6">
                    <div class="booking-card">
                        <div class="booking-img-wrapper">
                            <span class="booking-status-badge <%= booking.status === 'Cancelled' ? 'status-cancelled' : 'status-confirmed' %>">
                                <i class="fa-solid <%= booking.status === 'Cancelled' ? 'fa-xmark' : 'fa-check' %> me-1"></i> <%= booking.status %>
                            </span>
                            <img src="<%= booking.listing && booking.listing.image ? booking.listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=600' %>" class="booking-img" alt="<%= booking.listing ? booking.listing.title : 'Stay' %>">
                        </div>

                        <div class="booking-body">
                            <% if (booking.listing) { %>
                                <a href="/listings/<%= booking.listing._id %>" class="booking-stay-title text-truncate d-block">
                                    <%= booking.listing.title %>
                                </a>
                                <p class="booking-location">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= booking.listing.location %>, <%= booking.listing.country %>
                                </p>
                            <% } else { %>
                                <h5 class="booking-stay-title text-secondary">Listing unavailable</h5>
                            <% } %>

                            <div class="date-pill-box">
                                <div class="row g-2 text-center">
                                    <div class="col-6 border-end">
                                        <div class="date-item-label">Check-in</div>
                                        <div class="date-item-val"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="date-item-label">Check-out</div>
                                        <div class="date-item-val"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center small text-secondary mb-3">
                                <span><i class="fa-solid fa-moon text-primary me-1"></i> <%= booking.totalNights %> <%= booking.totalNights === 1 ? 'night' : 'nights' %></span>
                                <span><i class="fa-solid fa-user-group text-danger me-1"></i> <%= booking.guests %> <%= booking.guests === 1 ? 'guest' : 'guests' %></span>
                            </div>

                            <div class="price-summary-box">
                                <div class="d-flex justify-content-between align-items-baseline mb-3">
                                    <span class="small text-secondary fw-semibold">Total Paid (inc. GST)</span>
                                    <span class="fs-5 fw-bold text-dark">&#8377;<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : "0" %></span>
                                </div>

                                <% if (booking.status === "Confirmed") { %>
                                    <button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-bold py-2" data-bs-toggle="modal" data-bs-target="#cancelModal-<%= booking._id %>">
                                        <i class="fa-solid fa-ban me-1"></i> Cancel Reservation
                                    </button>

                                    <!-- Modern Cancel Reservation Modal -->
                                    <div class="modal fade" id="cancelModal-<%= booking._id %>" tabindex="-1" aria-labelledby="cancelModalLabel-<%= booking._id %>" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 rounded-4 shadow-lg p-3">
                                                <div class="modal-body text-center p-3 p-md-4">
                                                    <div class="mx-auto mb-3 text-danger bg-danger-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 68px; height: 68px; font-size: 1.8rem;">
                                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                                    </div>
                                                    <h4 class="fw-bold text-dark mb-2">Cancel Reservation?</h4>
                                                    <p class="text-secondary small mb-4">
                                                        Are you sure you want to cancel your reservation for 
                                                        <strong class="text-dark"><%= booking.listing ? booking.listing.title : 'this stay' %></strong>? 
                                                        Your dates will be released back to the host.
                                                    </p>
                                                    <div class="d-flex gap-2 justify-content-center">
                                                        <button type="button" class="btn btn-light rounded-pill px-3 py-2.5 fw-bold flex-fill" data-bs-dismiss="modal">
                                                            Keep Stay
                                                        </button>
                                                        <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE" class="d-inline flex-fill">
                                                            <button type="submit" class="btn btn-danger rounded-pill px-3 py-2.5 fw-bold w-100 shadow-sm">
                                                                Yes, Cancel
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <button class="btn btn-light btn-sm w-100 rounded-pill fw-bold py-2 text-secondary" disabled>
                                        Reservation Cancelled
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div class="empty-trips-card">
            <div class="empty-trips-icon">
                <i class="fa-solid fa-suitcase-rolling"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">No Trips Booked Yet!</h3>
            <p class="text-secondary mb-4">You haven't made any stay reservations. Explore handpicked luxury villas and cozy getaways today.</p>
            <a href="/listings" class="btn btn-danger btn-lg rounded-pill px-4 fw-bold shadow">
                <i class="fa-solid fa-compass me-2"></i> Explore Haven Stays
            </a>
        </div>
    <% } %>
</div>
